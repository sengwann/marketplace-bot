# Same names are used on your laptop (.env file) and on Render (Environment tab).
# Do NOT put quotes around values.

# --- Telegram ---
BOT_TOKEN=123456:ABC-from-BotFather
# Admin group ID (negative number, e.g. -1001234567890). The bot must be a member.
ADMIN_CHAT_ID=-1001234567890
# Public channel ID or @username. The bot must be an admin of the channel.
CHANNEL_ID=-1009876543210
# Telegram user IDs of admins, comma separated
ADMIN_USER_IDS=111111111,222222222
# Shown in the /start message
CHANNEL_NAME=Shwe Kokko Marketplace

# --- Database (Supabase) ---
# Supabase dashboard > Connect > "Session pooler" (port 5432).
# Do not use the "Direct connection": Render cannot reach it (IPv6 only).
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase needs this
DATABASE_SSL=true
# DATABASE_CA_CERT=

# --- Webhook (leave WEBHOOK_DOMAIN empty to use long polling on your laptop) ---
# On Render: your service address, e.g. https://skk-bot.onrender.com
WEBHOOK_DOMAIN=https://your-app.onrender.com
WEBHOOK_SECRET_TOKEN=pick-a-long-random-string
# WEBHOOK_PATH=/telegram/webhook

# --- Limits ---
# Max listings one seller can submit per rolling 24 hours (admins are exempt).
# Change it any time and restart. 0 = no limit. Default: 5
MAX_LISTINGS_PER_USER_PER_DAY=5

# --- Keep-alive (stops Render's free plan from sleeping) ---
# The bot pings its own address every 5 minutes, except during quiet hours.
# Render sets RENDER_EXTERNAL_URL itself, so you normally need nothing here.
# The main pinger is the job on cron-job.org (see README); this is the backup.
# Quiet hours: no ping from 00:00 until 05:00 in this time zone (Myanmar time).
# Use the same hours in the cron-job.org job. Empty value = ping all day.
# KEEP_ALIVE_QUIET_HOURS=0-5
# KEEP_ALIVE_TIMEZONE=Asia/Yangon
# KEEP_ALIVE=false
# KEEP_ALIVE_URL=https://your-app.onrender.com

# --- Optional ---
# SENTRY_DSN=
# LOG_LEVEL=info
# PORT=3000
